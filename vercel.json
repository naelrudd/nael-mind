  {
    "version": 2,
    "routes": [
      { "src": "/graph", "dest": "/graphify-out/graph.html" },
      { "src": "/graphify-out/(.*)", "dest": "/graphify-out/$1" },
      { "src": "/context", "dest": "/api/context-page" },
      { "src": "/api/content/(.*)", "dest": "/api/read?filename=content/$1" },
      { "src": "/api/(.*)", "dest": "/api/$1" },
      { "src": "/gui/(.*)", "dest": "/gui/$1" },
      { "handle": "filesystem" },
      { "src": "/(.*)", "dest": "/gui/index.html" }
    ]
  }
